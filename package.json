{
  "name": "dsh-429-auto-continue",
  "version": "1.0.2",
  "description": "429 兜底插件：回合因 429/限流/配额耗尽死掉后，等待可配置的延迟（默认 10 秒）自动向会话发送「继续任务」，任务自动接着跑。",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "429",
    "rate-limit",
    "quota",
    "continue",
    "auto-continue",
    "resume"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js"
  },
  "license": "MIT"
}
